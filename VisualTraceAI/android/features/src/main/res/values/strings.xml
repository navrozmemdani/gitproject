    <!-- Consent -->
    <string name="consent_title">Share images with search providers?</string>
    <string name="consent_body">Some reverse-image providers (e.g. TinEye, Google Lens via SerpApi) need a copy of your image to search. Your image is sent only for this search and is deleted from our servers when processing ends. Keyword-based providers receive only descriptive keywords.</string>
