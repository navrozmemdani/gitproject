<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain HTTP so the app can reach a development backend on the
     emulator host or on a computer in the same Wi-Fi network (Settings > Server).
     Release builds use the HTTPS-only configuration in src/main. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
