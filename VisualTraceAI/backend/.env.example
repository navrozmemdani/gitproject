# ---------------------------------------------------------------------------
# VisualTrace AI backend configuration. Copy to `.env` and fill in.
# NEVER commit `.env`. Provider secrets live only here, never in the app.
# ---------------------------------------------------------------------------
ENVIRONMENT=development            # development | staging | production
DEBUG=false
PUBLIC_BASE_URL=                   # e.g. https://api.visualtrace.example (HTTPS). Needed for SerpApi Lens.
CORS_ORIGINS=

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://visualtrace:visualtrace@localhost:5432/visualtrace

# --- Security --------------------------------------------------------------
CLIENT_API_KEYS=                   # comma separated client keys (sent by the app as X-API-Key)
FIREBASE_CREDENTIALS_FILE=         # path to service-account JSON (or set FIREBASE_PROJECT_ID)
FIREBASE_PROJECT_ID=
ALLOW_GUEST=true
AUTH_DEV_TOKENS=false              # development only: accepts "Bearer dev:<name>"
SIGNED_URL_SECRET=change-me        # random 32+ chars in production
RATE_LIMIT_PER_MINUTE=30
SEARCH_RATE_LIMIT_PER_HOUR=60

# --- Uploads ---------------------------------------------------------------
TEMP_DIR=./tmp
MAX_IMAGE_BYTES=15728640
MAX_VIDEO_BYTES=209715200
MAX_FRAMES_PER_VIDEO=40
TEMP_FILE_TTL_SECONDS=900
CLAMAV_HOST=                       # optional clamd host for malware scanning
CLAMAV_PORT=3310

# --- Video -----------------------------------------------------------------
DEFAULT_FRAME_INTERVAL_SECONDS=3
MAX_VIDEO_DURATION_SECONDS=600

# --- AI --------------------------------------------------------------------
EMBEDDING_BACKEND=auto             # auto | clip | opencv
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
OCR_ENABLED=true

# --- Providers ---------------------------------------------------------------
PROVIDER_TIMEOUT_SECONDS=12
PROVIDER_MAX_RETRIES=2
PROVIDER_MOCK_MODE=false           # DEVELOPMENT ONLY: flagged mock results for unconfigured providers
MAX_RESULTS_PER_PROVIDER=20

GOOGLE_CSE_API_KEY=                # https://developers.google.com/custom-search/v1/overview
GOOGLE_CSE_CX=
BING_VISUAL_SEARCH_KEY=            # Bing Search APIs retired Aug 2025 - only for eligible endpoints
BING_VISUAL_SEARCH_ENDPOINT=
SERPAPI_API_KEY=                   # https://serpapi.com/google-lens-api
TINEYE_API_KEY=                    # https://services.tineye.com/TinEyeAPI
TINEYE_API_URL=https://api.tineye.com/rest/
REDDIT_CLIENT_ID=                  # https://www.reddit.com/prefs/apps (script/web app)
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=VisualTraceAI/1.0 (by u/your_account)
X_BEARER_TOKEN=                    # X API v2 (Basic tier or above for recent search)
PINTEREST_ACCESS_TOKEN=
META_GRAPH_ACCESS_TOKEN=           # Instagram Graph API (business account, hashtag search permission)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
TIKTOK_RESEARCH_CLIENT_KEY=        # TikTok Research API (approved researchers only)
TIKTOK_RESEARCH_CLIENT_SECRET=
OPENVERSE_ENABLED=true
WIKIMEDIA_ENABLED=true
HTTP_USER_AGENT=VisualTraceAI/1.0 (+https://your-domain/bot; contact@your-domain)
